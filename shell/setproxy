#!/usr/bin/env bash
# setproxy - Smart wrapper for _setproxy binary
# Automatically handles eval for shell integration

# Find _setproxy binary
SETPROXY_BIN="${SETPROXY_BIN:-$(command -v _setproxy 2>/dev/null)}"

if [ -z "$SETPROXY_BIN" ]; then
    echo "✗ _setproxy binary not found in PATH" >&2
    echo "Please ensure setproxy is properly installed." >&2
    exit 1
fi

# Check if we're being sourced or executed
if [ -n "$BASH_VERSION" ]; then
    (return 0 2>/dev/null) && SOURCED=1 || SOURCED=0
elif [ -n "$ZSH_VERSION" ]; then
    [[ $ZSH_EVAL_CONTEXT =~ :file$ ]] && SOURCED=1 || SOURCED=0
else
    SOURCED=0
fi

if [ "$SOURCED" = "1" ]; then
    # Being sourced - define the function in current shell
    setproxy() {
        local _bin
        _bin=$(command -v _setproxy 2>/dev/null) || {
            echo "✗ _setproxy not found, please install it first" >&2
            return 1
        }
        if [ "$1" = "status" ] || [ "$1" = "s" ]; then
            "$_bin" "$@"
        else
            eval "$("$_bin" "$@")"
        fi
    }
else
    # Being executed directly (pixi trampoline context)
    case "${1:-}" in
        status|s|--help|-h|--version|-V)
            # Read-only commands: run directly
            exec "$SETPROXY_BIN" "$@"
            ;;
        *)
            # Mutating command: auto-configure shell integration, then guide user
            _MARKER="# >>> setproxy initialized <<<"
            _INIT_LINE='eval "$(_setproxy shell-init)"'

            # Detect shell RC file
            if echo "${SHELL:-}" | grep -q "zsh"; then
                _RC="$HOME/.zshrc"
            elif echo "${SHELL:-}" | grep -q "bash"; then
                _RC="$HOME/.bashrc"
            else
                _RC=""
            fi

            if [ -n "$_RC" ]; then
                # Check if already configured
                if ! grep -qF "$_MARKER" "$_RC" 2>/dev/null; then
                    printf '\n%s\n%s\n' "$_MARKER" "$_INIT_LINE" >> "$_RC"
                fi
            fi

            echo "✓ Shell integration configured in ${_RC:-your shell RC}" >&2
            echo "" >&2
            echo "Restart your terminal, then run:" >&2
            echo "" >&2
            echo "  setproxy $*" >&2
            echo "" >&2
            exit 0
            ;;
    esac
fi
